      "feel": "Ground and rest: structure, focus, quiet",
      "ink": {
        "name": "Ink",
        "hex": "#1f2327",
        "use": "body text, headings",
        "contrastOnPaper": 15.1
      },
      "paper": {
        "name": "Paper",
        "hex": "#fafaf7",
        "use": "page background",
        "contrastOnPaper": 1
      },
      "stone": {
        "name": "Stone",
